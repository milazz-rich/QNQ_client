# Copiare in `.env` e adattare. Il file `.env` NON va versionato.

# --- MongoDB ---------------------------------------------------------------
# 172.17.32.1 e' il gateway della rete WSL verso l'host Windows.
# ATTENZIONE: questo IP cambia fra i riavvii. Per rileggerlo, da WSL:
#     ip route show | grep default
MONGO_HOST=172.17.32.1
MONGO_PORT=27017
MONGO_DB=qnq
# Se valorizzata, MONGO_URI ha la precedenza su MONGO_HOST/MONGO_PORT.
MONGO_URI=
MONGO_TIMEOUT_MS=5000

# --- Misurazioni -----------------------------------------------------------
# Binario curl usato per le misure: deve essere compilato con HTTP/2 E HTTP/3
# (verificare con `curl --version`, riga "Features:").
# La tilde viene espansa dall'applicazione.
CURL_BINARY_PATH=~/curl/src/curl
# Margine, in ms, concesso al processo curl oltre il proprio --max-time prima di
# essere ucciso a forza.
CURL_KILL_GRACE_MS=2000
# Opzionale. Percorso di un certificato CA custom (--cacert), per validare
# target con certificato self-signed o emesso da una CA privata invece di
# disabilitare la verifica TLS. Vuoto di default (nessun bundle custom).
# La tilde viene espansa dall'applicazione.
CURL_CA_BUNDLE_PATH=
# Pausa, in ms, fra una ripetizione e la successiva all'interno dello stesso
# SessionItem. Applicata SEMPRE, per qualunque client/target/protocollo (mai
# solo dove "serve"): mitiga il rate limiter sulle nuove connessioni di
# OpenLiteSpeed, ma va uniforme per non introdurre una variabile in piu' fra
# i dati raccolti su target diversi.
MEASUREMENT_DELAY_MS=300

# --- Client di misura "Chrome" (Playwright) --------------------------------
# Hash SPKI (SHA-256, base64) dei certificati self-signed da far accettare a
# Chromium. Accetta piu' valori separati da virgola: ambienti diversi (Docker,
# KVM) usano certificati diversi.
# ATTENZIONE: e' l'unico modo di far funzionare HTTP/3 con cert self-signed;
# il flag generico --ignore-certificate-errors fa fallire QUIC.
# Si calcola con:
#   openssl x509 -in CERT.crt -pubkey -noout \
#     | openssl pkey -pubin -outform der \
#     | openssl dgst -sha256 -binary | openssl enc -base64
CHROME_CERT_SPKI_HASH=
# Quando considerare conclusa la navigazione: load | commit | domcontentloaded.
# "load" (default) attende anche le sotto-risorse della pagina.
CHROME_WAIT_UNTIL=load

# --- API -------------------------------------------------------------------
APP_ENV=development
API_PREFIX=/api
# Lista separata da virgole. 4200 e' il dev server Angular.
CORS_ORIGINS=http://localhost:4200
